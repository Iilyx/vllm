# Путь внутри контейнера до папки, где лежит config.json.
MODEL_PATH=/models/Qwen3.5-4B

# RTX 4070 Ti Super, 16 ГБ. Длинный контекст вместе с картинками всё равно дорогой.
MAX_MODEL_LEN=8192
GPU_MEMORY_UTILIZATION=0.90
# Одновременные запросы. В логе KV-кэша хватило на 196, дефолтные 256 роняют старт.
MAX_NUM_SEQS=32

# Внутренний ключ между LiteLLM и vLLM. Клиентам его не дают.
VLLM_API_KEY=change-me-internal

# Пароль Postgres, где лежат хэши ключей и сроки.
POSTGRES_PASSWORD=change-me-db

# Этим ключом выдают клиентские ключи. В интернет его не кладут.
LITELLM_MASTER_KEY=sk-change-me-master
# Шифрует секреты в базе. После первого запуска не менять.
LITELLM_SALT_KEY=sk-change-me-salt
