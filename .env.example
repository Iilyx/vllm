# Путь внутри контейнера до папки, где лежит config.json.
# Веса прямо в ./models  ->  /models
# Веса в ./models/Qwen3.5-4B  ->  /models/Qwen3.5-4B
MODEL_PATH=/models

# RTX 4070 Ti Super, 16 ГБ. Длинный контекст вместе с картинками всё равно дорогой.
MAX_MODEL_LEN=8192
GPU_MEMORY_UTILIZATION=0.90
# Одновременные запросы. В логе KV-кэша хватило на 196, дефолтные 256 роняют старт.
MAX_NUM_SEQS=32
